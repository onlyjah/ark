{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Ark so/il request authority v1",
  "type":"object",
  "additionalProperties":false,
  "required":["v","app","audience","action","expires","nonce","request"],
  "properties":{
    "v":{"const":1},
    "app":{"type":"string","minLength":1},
    "audience":{"type":"string","minLength":1},
    "subject":{"type":"string","minLength":1},
    "owner":{"type":"string","minLength":1},
    "resource":{"type":"string","minLength":1},
    "action":{"type":"string","minLength":1},
    "expires":{"type":"integer","description":"Unix milliseconds; verified against current time and 30-second maximum"},
    "nonce":{"type":"string","format":"uuid"},
    "request":{"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
