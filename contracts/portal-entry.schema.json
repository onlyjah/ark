{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Ark so/il port entry v1",
  "type":"object",
  "required":["id","app","audience","owner","resource","destination","action","methods","secret"],
  "additionalProperties":false,
  "properties":{
    "id":{"type":"string","pattern":"^[a-z0-9-]{1,64}$"},
    "app":{"type":"string","minLength":1},
    "audience":{"type":"string","minLength":1},
    "owner":{"type":"string","minLength":1},
    "resource":{"type":"string","minLength":1},
    "destination":{"type":"string","format":"uri","pattern":"^https?://"},
    "action":{"type":"string","minLength":1},
    "methods":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["GET","POST","PUT","PATCH","DELETE"]}},
    "subjects":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "secret":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "maxBytes":{"type":"integer","minimum":1,"maximum":2000000}
  }
}
