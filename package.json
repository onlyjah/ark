{
  "name": "kash-app",
  "version": "0.4.0",
  "private": true,
  "description": "KASH client operator on Ark with provider-configured SO/IL and portable installation",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "start": "bun railway/ark-core.function.ts",
    "test": "node --test test/*.test.ts",
    "check:quotes": "node scripts/check-quotes.ts",
    "build:railway": "node scripts/build-railway.ts",
    "start:core": "node src/cli.ts serve",
    "build": "node scripts/build-railway.ts",
    "build:services": "node scripts/build-services.ts",
    "serve:accounts": "bun dist/accounts.mjs",
    "serve:billing": "bun dist/billing.mjs",
    "serve:workspace": "bun dist/workspace.mjs",
    "serve:client": "bun dist/client.mjs",
    "serve:portalizer": "bun dist/portalizer.mjs",
    "install:local": "node scripts/install.ts",
    "build:portable": "bun scripts/build-portable.ts",
    "test:ui": "node test/markdown-ui/check.cjs && node test/markdown-ui/member-check.cjs && node test/markdown-ui/kash-check.cjs"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "jose": "6.2.12",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
