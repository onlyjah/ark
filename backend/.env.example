# Documentation only. Go reads the process environment; it does not source files.
# Local defaults use a separate SQLite database and object directory.
KASH_DATA=./data-go
KASH_APP_ORIGIN=http://localhost:8080
KASH_LISTEN_HOST=127.0.0.1
PORT=8080
KASH_OBJECT_STORE=local
SOIL_API_URL=https://soil.jah.earth/api/v1
SOIL_APP_URL=https://soil.jah.earth/app
SOIL_AUDIENCE=kash
KASH_EMBED_ORIGINS=https://jah.earth

# Shared metadata authority: server-only Postgres connection string.
# KASH_DATABASE_URL=
# KASH_OBJECT_STORE=s3
# KASH_S3_ENDPOINT=
# KASH_S3_REGION=
# KASH_S3_BUCKET=
# KASH_S3_ACCESS_KEY_ID=
# KASH_S3_SECRET_ACCESS_KEY=

# Native bridge only. Keep all three out of git, logs and URL query strings.
# KASH_SOIL_TOKEN=
# SOIL_CLIENT_ID=
# KASH_CONTENT_KEY=
